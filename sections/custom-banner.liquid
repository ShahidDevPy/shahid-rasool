{%- comment -%}
  ---------------------------------------------------------------------------
  Custom Banner — "The Gift Guide"
  ---------------------------------------------------------------------------
  Built from scratch for the Ecomexperts test. Deliberately does NOT reuse any
  theme section, block, snippet or `@theme/*` JS module.

  Structure (matches the Figma frame top-to-bottom):
    1. Utility bar .... logo · tagline · accent CTA          (optionally sticky)
    2. Hero .......... full-width art band, then copy beside a narrower band
    3. Strip ......... single centred line of small-caps text

  Notes:
  - No JavaScript. Both button animations are pure CSS transitions, so this
    section adds zero script weight to the page.
  - Styles live in assets/gg-banner.css; the button primitives it shares with
    the grid live in assets/gg-shared.css.
  - The artwork is the LCP element, so it is preloaded at high priority while
    everything else stays lightweight.
{%- endcomment -%}

{{ 'gg-shared.css' | asset_url | stylesheet_tag }}
{{ 'gg-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  # Two separate exports: a full-width band above, and a narrower panel that
  # sits beside the copy below. Each ships as a theme asset; a Customizer image
  # overrides either one without a code change.
  assign art_top_url = 'banner-top-frame.svg' | asset_url
  if s.art_top_image != blank
    assign art_top_url = s.art_top_image | image_url: width: 2400
  endif

  assign art_bottom_url = 'banner-frame.svg' | asset_url
  if s.art_bottom_image != blank
    assign art_bottom_url = s.art_bottom_image | image_url: width: 1800
  endif

  # Resolved up front: the render tag cannot take filtered arguments.
  assign bar_button_href = s.bar_button_link | default: routes.all_products_collection_url
  assign hero_button_href = s.hero_button_link | default: routes.all_products_collection_url

  # The section owns its typography rather than inheriting the store's theme
  # font, so this page renders correctly wherever it is dropped — and without
  # changing the font anywhere else on the store.
  assign font_medium = s.font | font_modify: 'weight', '500'
-%}

{%- comment -%}
  font_face emits a bare @font-face rule, so it must sit inside a style tag —
  otherwise the CSS prints onto the page as text.
{%- endcomment -%}
{% style %}
  {{ s.font | font_face: font_display: 'swap' }}
  {%- if font_medium -%}
    {{ font_medium | font_face: font_display: 'swap' }}
  {%- endif -%}
{% endstyle %}

{%- comment -%}
  The top band is above the fold and carries the page's LCP, so it is fetched at
  high priority rather than waiting on layout. The lower band is not preloaded —
  it is further down and would only compete for bandwidth.
{%- endcomment -%}
{{ art_top_url | preload_tag: as: 'image' }}



<div
  class="gg-banner"
  style="
    --gg-accent: {{ s.accent_color }};
    --gg-ink: {{ s.text_color }};
    --gg-bar-bg: {{ s.bar_background }};
    --gg-strip-bg: {{ s.strip_background }};
    --gg-panel-width: {{ s.panel_width }}%;
    --gg-font: {{ s.font.family }}, {{ s.font.fallback_families }};
  "
>
  {%- comment -%} 1. Utility bar {%- endcomment -%}
  <div class="gg-banner__bar{% if s.sticky_bar %} gg-banner__bar--sticky{% endif %}">
    {%- if s.logo_text != blank -%}
      <a class="gg-banner__logo" href="{{ s.logo_link | default: routes.root_url }}">
        {{- s.logo_text -}}
      </a>
    {%- endif -%}

    {%- if s.tagline != blank -%}
      <p class="gg-banner__tagline">{{ s.tagline }}</p>
    {%- endif -%}

    {%- if s.bar_button_label != blank -%}
      {%- render 'gg-button',
        label: s.bar_button_label,
        href: bar_button_href,
        variant: 'accent'
      -%}
    {%- endif -%}
  </div>

  {%- comment -%}
    2. Hero — a full-width band above, then copy beside a narrower band.

    Both are <img> rather than CSS backgrounds so the intrinsic width/height
    reserve their space and the artwork causes no layout shift.
  {%- endcomment -%}
  <div class="gg-banner__hero">
    <img
      class="gg-banner__art gg-banner__art--top"
      src="{{ art_top_url }}"
      alt=""
      width="1440"
      height="390"
      loading="eager"
      fetchpriority="high"
    >

    <div class="gg-banner__lower">
      <div class="gg-banner__panel">
        {%- if s.heading != blank -%}
          <h1 class="gg-banner__heading">{{ s.heading }}</h1>
        {%- endif -%}

        {%- if s.body != blank -%}
          <div class="gg-banner__body">{{ s.body }}</div>
        {%- endif -%}

        {%- if s.hero_button_label != blank -%}
          {%- render 'gg-button',
            label: s.hero_button_label,
            href: hero_button_href,
            variant: 'solid'
          -%}
        {%- endif -%}
      </div>

      <img
        class="gg-banner__art gg-banner__art--bottom"
        src="{{ art_bottom_url }}"
        alt=""
        width="890"
        height="402"
        loading="lazy"
      >
    </div>
  </div>

  {%- comment -%} 3. Strip {%- endcomment -%}
  {%- if s.strip_text != blank -%}
    <div class="gg-banner__strip">
      <span>{{ s.strip_text }}</span>
    </div>
  {%- endif -%}
</div>


{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Utility bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "info": "Hidden on mobile to protect the call to action.",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "bar_button_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "bar_button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "sticky_bar",
      "label": "Stick bar to top on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Artwork",
      "info": "Two separate exports: a full-width band on top, a narrower one beside the copy."
    },
    {
      "type": "image_picker",
      "id": "art_top_image",
      "label": "Top band override",
      "info": "Optional. Defaults to assets/banner-top-frame.svg (1440x390)."
    },
    {
      "type": "image_picker",
      "id": "art_bottom_image",
      "label": "Lower band override",
      "info": "Optional. Defaults to assets/banner-frame.svg (890x402)."
    },
    {
      "type": "range",
      "id": "panel_width",
      "label": "Copy column width",
      "min": 30,
      "max": 50,
      "step": 0.2,
      "unit": "%",
      "default": 38.2,
      "info": "Figma splits 1440 as 550 copy / 890 artwork = 38.2%."
    },
    {
      "type": "header",
      "content": "Strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    {
      "type": "header",
      "content": "Typography",
      "info": "Set on the section so this page keeps its own type without changing the store's theme font."
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "jost_n4"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#fff544"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Utility bar background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "strip_background",
      "label": "Strip background",
      "default": "#f5f5f5"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
