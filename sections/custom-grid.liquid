{%- comment -%}
  ---------------------------------------------------------------------------
  Custom Grid — "Tisso vison in the wild"
  ---------------------------------------------------------------------------
  Six product blocks in a 3x2 grid. Marker positions are per block, since the
  design places them on the garment rather than a fixed corner.

  Clicking a marker opens one shared popup, hydrated from the product data
  serialised below — so opening it costs no network request.
{%- endcomment -%}

{{ 'gg-shared.css' | asset_url | stylesheet_tag }}
{{ 'gg-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-gift-guide.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign s = section.settings

  # The section owns its typography rather than inheriting the theme font. The
  # heading is a separate picker for the design's serif/sans contrast.
  assign font_medium = s.font | font_modify: 'weight', '500'
  assign font_light = s.font | font_modify: 'weight', '300'

  # Per-block pickers first; unset blocks fall back to the nth product of a
  # collection, so a fresh section shows real products rather than empty tiles.
  if s.fallback_collection != blank
    assign fallback_products = s.fallback_collection.products
  else
    assign fallback_products = collections.all.products
  endif
-%}

{%- comment -%}
  font_face emits a bare @font-face rule, so it must sit inside a style tag —
  otherwise the CSS prints onto the page as text.
{%- endcomment -%}
{% style %}
  {{ s.font | font_face: font_display: 'swap' }}
  {%- if font_medium -%}
    {{ font_medium | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if font_light -%}
    {{ font_light | font_face: font_display: 'swap' }}
  {%- endif -%}
  {{ s.heading_font | font_face: font_display: 'swap' }}
{% endstyle %}

<gift-guide-grid
  class="gg-grid"
  style="
    --gg-ink: {{ s.text_color }};
    --gg-grid-gap: {{ s.gap }}px;
    --gg-marker-size: {{ s.marker_size }}px;
    --gg-font: {{ s.font.family }}, {{ s.font.fallback_families }};
    --gg-heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
  "
>
  {%- if s.heading != blank -%}
    <h2 class="gg-grid__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="gg-grid__items">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        if product == blank
          assign product = fallback_products[forloop.index0]
        endif
        assign image = block.settings.image | default: product.featured_image
      -%}
      <div class="gg-grid__item" {{ block.shopify_attributes }}>
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 900
            | image_tag:
              class: 'gg-grid__image',
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
              alt: image.alt
          }}
        {%- else -%}
          <div class="gg-grid__image gg-grid__image--empty" role="presentation"></div>
        {%- endif -%}

        {%- if product != blank -%}
          {%- comment -%}
            A real <button> so it is keyboard reachable. It doubles as the close
            control once open, matching the design's "+" to "x" swap.
          {%- endcomment -%}
          <button
            type="button"
            class="gg-grid__marker"
            style="--gg-marker-x: {{ block.settings.marker_x }}%; --gg-marker-y: {{ block.settings.marker_y }}%;"
            data-gg-open="{{ forloop.index0 }}"
            aria-expanded="false"
            aria-label="{{ 'View details for' | append: ' ' | append: product.title | escape }}"
          >
            <span class="gg-grid__marker-plus">{%- render 'gg-icon', name: 'plus' -%}</span>
            <span class="gg-grid__marker-close">{%- render 'gg-icon', name: 'close' -%}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Popup data, trimmed to the fields it actually uses. {%- endcomment -%}
  <script type="application/json" data-gg-products>
    [
      {%- for block in section.blocks -%}
        {%- comment -%}
          Must resolve exactly as the markup loop, or a marker's index would
          address a different product than the tile it sits on.
        {%- endcomment -%}
        {%- liquid
          assign p = block.settings.product
          if p == blank
            assign p = fallback_products[forloop.index0]
          endif
        -%}
        {%- if p == blank -%}
          null
        {%- else -%}
          {
            "title": {{ p.title | json }},
            "description": {{ p.description | strip_html | truncatewords: 40 | json }},
            "image": {{ p.featured_image | image_url: width: 700 | json }},
            "imageAlt": {{ p.featured_image.alt | default: p.title | json }},
            "url": {{ p.url | json }},
            "optionNames": {{ p.options | json }},
            "variants": [
              {%- for v in p.variants -%}
                {
                  "id": {{ v.id }},
                  "options": {{ v.options | json }},
                  "available": {{ v.available }},
                  "price": {{ v.price | money | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  {%- comment -%}
    Option value -> hex from the "Colour swatches" setting. The trailing
    separator is safe: Liquid's split drops the empty final element, so the join
    never leaves a dangling comma.
  {%- endcomment -%}
  {%- capture swatch_pairs -%}
    {%- assign swatch_lines = s.swatch_colors | newline_to_br | split: '<br />' -%}
    {%- for line in swatch_lines -%}
      {%- assign pair = line | strip | split: ':' -%}
      {%- if pair.size >= 2 -%}
        {{ pair[0] | strip | downcase | json }}:{{ pair[1] | strip | json }}|
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign swatch_map = swatch_pairs | strip | split: '|' | join: ',' -%}

  {%- comment -%}
    A product picker cannot carry a schema default — it stores a store-specific
    id. So the companion falls back to a handle lookup, letting the rule work on
    a fresh install without any Customizer setup. The picker still wins when set,
    which is what lets a merchant point it elsewhere.
  {%- endcomment -%}
  {%- liquid
    assign bonus = s.bonus_product
    if bonus == blank and s.bonus_handle != blank
      assign bonus = all_products[s.bonus_handle]
    endif
  -%}
  <script type="application/json" data-gg-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "swatches": { {{ swatch_map }} },
      "bonus": {
        {%- if bonus != blank and bonus.first_available_variant != blank -%}
          "variantId": {{ bonus.first_available_variant.id }},
          "title": {{ bonus.title | json }},
        {%- else -%}
          "variantId": null,
          "title": null,
        {%- endif -%}
        "triggers": [{{ s.bonus_trigger_a | json }}, {{ s.bonus_trigger_b | json }}]
      },
      "strings": {
        "addToCart": {{ s.add_to_cart_label | json }},
        "added": {{ s.added_label | json }},
        "soldOut": {{ s.sold_out_label | json }},
        "error": {{ s.error_label | json }}
      }
    }
  </script>

  {%- comment -%} Shared popup. One instance, hydrated per marker click. {%- endcomment -%}
  <div class="gg-popup" data-gg-popup hidden>
    <div class="gg-popup__backdrop" data-gg-close></div>

    <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gg-popup-title-{{ section.id }}">
      <button type="button" class="gg-popup__close" data-gg-close aria-label="Close">
        {%- render 'gg-icon', name: 'close' -%}
      </button>

      <div class="gg-popup__head">
        <img class="gg-popup__image" data-gg-image alt="" width="280" height="280">
        <div class="gg-popup__intro">
          <h3 class="gg-popup__title" id="gg-popup-title-{{ section.id }}" data-gg-title></h3>
          <p class="gg-popup__price" data-gg-price></p>
          <p class="gg-popup__description" data-gg-description></p>
        </div>
      </div>

      {%- comment -%} Option controls are generated from the variant data. {%- endcomment -%}
      <div class="gg-popup__options" data-gg-options></div>

      {%- render 'gg-button',
        label: s.add_to_cart_label,
        variant: 'solid',
        class: 'gg-popup__atc',
        attrs: 'data-gg-add',
        label_attrs: 'data-gg-add-label'
      -%}

      <p class="gg-popup__status" data-gg-status role="status" aria-live="polite"></p>
    </div>
  </div>
</gift-guide-grid>


{% schema %}
{
  "name": "Custom Grid",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22,
      "info": "Figma: 22px on desktop, 15.71px on mobile (handled in CSS). Tap target stays 44px."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography",
      "info": "Set on the section so this page keeps its own type without changing the store's theme font."
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Body font",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4",
      "info": "Figma uses Lustria, which Shopify does not host — Playfair Display is the closest hosted serif. Also drives the popup price."
    },
    {
      "type": "textarea",
      "id": "swatch_colors",
      "label": "Colour swatches",
      "info": "One per line as Name: #hex. Values not listed fall back to the colour name itself, then to neutral grey.",
      "default": "Blue: #0D499F\nRed: #B20F36\nGrey: #AFAFB7"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Fills any block whose product is unset, in order. Leave empty to use all products. Per-block pickers always take precedence."
    },
    {
      "type": "header",
      "content": "Automatic companion product",
      "info": "When a shopper adds a variant matching BOTH trigger values, this product is added to the cart alongside it."
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Product to auto-add",
      "info": "Optional — overrides the handle below. Leave empty to use Soft Winter Jacket."
    },
    {
      "type": "text",
      "id": "bonus_handle",
      "label": "Fallback product handle",
      "info": "Handle for the \"Soft Winter Jacket\" product (its title and URL handle differ on this store).",
      "default": "dark-winter-jacket"
    },
    {
      "type": "text",
      "id": "bonus_trigger_a",
      "label": "Trigger value 1",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "bonus_trigger_b",
      "label": "Trigger value 2",
      "default": "Medium"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added confirmation",
      "default": "ADDED TO CART"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Optional. Falls back to the product's featured image."
        },
        {
          "type": "range",
          "id": "marker_x",
          "label": "Marker horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "marker_y",
          "label": "Marker vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "marker_x": 62,
            "marker_y": 56
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 85,
            "marker_y": 52
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 63,
            "marker_y": 21
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 72,
            "marker_y": 18
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 51,
            "marker_y": 26
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 76,
            "marker_y": 39
          }
        }
      ]
    }
  ]
}
{% endschema %}
