{%- comment -%}
  ---------------------------------------------------------------------------
  Custom Grid — "Tisso vison in the wild"
  ---------------------------------------------------------------------------
  Built from scratch for the Ecomexperts test. Reuses no theme section, block,
  snippet or `@theme/*` module.

  Six product blocks in a 3x2 grid. Each tile carries a "+" marker whose
  position is set per block, because in the design the markers sit on the
  garment rather than in a fixed corner.

  Clicking a marker opens a single shared popup that is hydrated from product
  data serialised below. Serialising server-side (rather than fetching on
  click) means opening the popup costs zero network requests.
{%- endcomment -%}

{{ 'gg-shared.css' | asset_url | stylesheet_tag }}
{{ 'gg-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-gift-guide.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign s = section.settings

  # The section owns its typography rather than inheriting the store's theme
  # font. The heading is a separate picker because the design deliberately
  # contrasts a serif heading against the body sans.
  assign font_medium = s.font | font_modify: 'weight', '500'
-%}

{%- comment -%}
  font_face emits a bare @font-face rule, so it must sit inside a style tag —
  otherwise the CSS prints onto the page as text.
{%- endcomment -%}
{% style %}
  {{ s.font | font_face: font_display: 'swap' }}
  {%- if font_medium -%}
    {{ font_medium | font_face: font_display: 'swap' }}
  {%- endif -%}
  {{ s.heading_font | font_face: font_display: 'swap' }}
{% endstyle %}

<gift-guide-grid
  class="gg-grid"
  style="
    --gg-ink: {{ s.text_color }};
    --gg-grid-gap: {{ s.gap }}px;
    --gg-marker-size: {{ s.marker_size }}px;
    --gg-font: {{ s.font.family }}, {{ s.font.fallback_families }};
    --gg-heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
  "
>
  {%- if s.heading != blank -%}
    <h2 class="gg-grid__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="gg-grid__items">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign image = block.settings.image | default: product.featured_image
      -%}
      <div class="gg-grid__item" {{ block.shopify_attributes }}>
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 900
            | image_tag:
              class: 'gg-grid__image',
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
              alt: image.alt
          }}
        {%- else -%}
          <div class="gg-grid__image gg-grid__image--empty" role="presentation"></div>
        {%- endif -%}

        {%- if product != blank -%}
          {%- comment -%}
            A real <button> so it is keyboard reachable. The marker doubles as
            the close control once its popup is open, matching the design's
            "+" to "x" swap.
          {%- endcomment -%}
          <button
            type="button"
            class="gg-grid__marker"
            style="--gg-marker-x: {{ block.settings.marker_x }}%; --gg-marker-y: {{ block.settings.marker_y }}%;"
            data-gg-open="{{ forloop.index0 }}"
            aria-expanded="false"
            aria-label="{{ 'View details for' | append: ' ' | append: product.title | escape }}"
          >
            <span class="gg-grid__marker-plus">{%- render 'gg-icon', name: 'plus' -%}</span>
            <span class="gg-grid__marker-close">{%- render 'gg-icon', name: 'close' -%}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%}
    Product data for the popup. Trimmed to the fields the popup actually needs
    rather than dumping the whole product object.
  {%- endcomment -%}
  <script type="application/json" data-gg-products>
    [
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}
          null
        {%- else -%}
          {
            "title": {{ p.title | json }},
            "description": {{ p.description | strip_html | truncatewords: 40 | json }},
            "image": {{ p.featured_image | image_url: width: 700 | json }},
            "imageAlt": {{ p.featured_image.alt | default: p.title | json }},
            "url": {{ p.url | json }},
            "optionNames": {{ p.options | json }},
            "variants": [
              {%- for v in p.variants -%}
                {
                  "id": {{ v.id }},
                  "options": {{ v.options | json }},
                  "available": {{ v.available }},
                  "price": {{ v.price | money | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  {%- comment -%}
    Cart config, including the automatic companion-product rule. Kept as
    settings rather than hardcoded strings so the rule is auditable and
    editable without touching JS.
  {%- endcomment -%}
  {%- assign bonus = s.bonus_product -%}
  <script type="application/json" data-gg-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "bonus": {
        {%- if bonus != blank and bonus.first_available_variant != blank -%}
          "variantId": {{ bonus.first_available_variant.id }},
          "title": {{ bonus.title | json }},
        {%- else -%}
          "variantId": null,
          "title": null,
        {%- endif -%}
        "triggers": [{{ s.bonus_trigger_a | json }}, {{ s.bonus_trigger_b | json }}]
      },
      "strings": {
        "addToCart": {{ s.add_to_cart_label | json }},
        "added": {{ s.added_label | json }},
        "soldOut": {{ s.sold_out_label | json }},
        "error": {{ s.error_label | json }}
      }
    }
  </script>

  {%- comment -%} Shared popup. One instance, hydrated per marker click. {%- endcomment -%}
  <div class="gg-popup" data-gg-popup hidden>
    <div class="gg-popup__backdrop" data-gg-close></div>

    <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gg-popup-title-{{ section.id }}">
      <button type="button" class="gg-popup__close" data-gg-close aria-label="Close">
        {%- render 'gg-icon', name: 'close' -%}
      </button>

      <div class="gg-popup__head">
        <img class="gg-popup__image" data-gg-image alt="" width="280" height="280">
        <div class="gg-popup__intro">
          <h3 class="gg-popup__title" id="gg-popup-title-{{ section.id }}" data-gg-title></h3>
          <p class="gg-popup__price" data-gg-price></p>
          <p class="gg-popup__description" data-gg-description></p>
        </div>
      </div>

      {%- comment -%} Option controls are generated from the variant data. {%- endcomment -%}
      <div class="gg-popup__options" data-gg-options></div>

      {%- render 'gg-button',
        label: s.add_to_cart_label,
        variant: 'solid',
        class: 'gg-popup__atc',
        attrs: 'data-gg-add',
        label_attrs: 'data-gg-add-label'
      -%}

      <p class="gg-popup__status" data-gg-status role="status" aria-live="polite"></p>
    </div>
  </div>
</gift-guide-grid>


{% schema %}
{
  "name": "Custom Grid",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography",
      "info": "Set on the section so this page keeps its own type without changing the store's theme font."
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Body font",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4",
      "info": "The design uses a serif here, contrasting the body sans."
    },
    {
      "type": "header",
      "content": "Automatic companion product",
      "info": "When a shopper adds a variant matching BOTH trigger values, this product is added to the cart alongside it."
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Product to auto-add",
      "info": "Set this to Soft Winter Jacket."
    },
    {
      "type": "text",
      "id": "bonus_trigger_a",
      "label": "Trigger value 1",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "bonus_trigger_b",
      "label": "Trigger value 2",
      "default": "Medium"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added confirmation",
      "default": "ADDED TO CART"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Optional. Falls back to the product's featured image."
        },
        {
          "type": "range",
          "id": "marker_x",
          "label": "Marker horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "marker_y",
          "label": "Marker vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "marker_x": 62,
            "marker_y": 56
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 85,
            "marker_y": 52
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 63,
            "marker_y": 21
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 72,
            "marker_y": 18
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 51,
            "marker_y": 26
          }
        },
        {
          "type": "product",
          "settings": {
            "marker_x": 76,
            "marker_y": 39
          }
        }
      ]
    }
  ]
}
{% endschema %}
